---
import { getSoliloquy } from '../../lib/soliloquy';
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import PromptLine from '../../components/PromptLine.astro';
import { render } from 'astro:content';
import { PROMPTS, SOLILOQUY, SEO } from '../../lib/constants';
import styles from './detail.module.css';

export async function getStaticPaths() {
  // entries are newest-first, so the neighbor above i is older (prev) and
  // below i is newer (next); numbering stays chronological across all pages
  const entries = await getSoliloquy();
  return entries.map((e, i) => ({
    params: { slug: e.slug },
    props: { e, prev: entries[i + 1], next: entries[i - 1], total: entries.length },
  }));
}

const { e, prev, next, total } = Astro.props;
const { Content } = await render(e.entry);

/*
 * SEO (ticket 30): entries opt in via colocated `ogImage` frontmatter
 * (spec §8); absent that, a satori-generated terminal card.
 */
const ogImage = e.entry.data.ogImage
  ? e.entry.data.ogImage.src
  : SEO.og.generatedFor('soliloquy', e.slug);
---

<TerminalLayout
  title={e.title ?? SOLILOQUY.dayISO(e.datetime)}
  description={e.excerpt}
  publishedTime={e.datetime}
  ogImage={ogImage}
  type="article"
>
  <PromptLine
    prompt={PROMPTS.section("soliloquy")}
    href="/soliloquy/"
    command={`show ${e.slug}`}
  />

  <div class={styles.wrap}>
    <article class={styles.printout}>
      {e.title && <h1 class={styles.title}>{e.title}</h1>}
      <p class={styles.stamp}>
        {SOLILOQUY.dayISO(e.datetime)} · {SOLILOQUY.time(e.datetime)} ·{" "}
        {SOLILOQUY.entryNo(e.number, total)}
      </p>
      <div class={styles.body}>
        <Content />
      </div>
      <p class={styles.eof} aria-hidden="true">{SOLILOQUY.eof}</p>
    </article>

    <nav class={styles.nav} aria-label="nearby entries">
      {
        prev ? (
          <a href={`/soliloquy/${prev.slug}/`} aria-label={`older: ${prev.title ?? prev.slug}`}>
            <span class={styles.navCmd}>{SOLILOQUY.navCmd(prev.number)}</span>
          </a>
        ) : (
          <span class={styles.navEnd}># nothing earlier</span>
        )
      }
      {
        next ? (
          <a href={`/soliloquy/${next.slug}/`} aria-label={`newer: ${next.title ?? next.slug}`}>
            <span class={styles.navCmd}>{SOLILOQUY.navCmd(next.number)}</span>
          </a>
        ) : (
          <span class={styles.navEnd}># nothing later</span>
        )
      }
    </nav>
  </div>
</TerminalLayout>