---
import { getStudies, relatedStudies } from '../../lib/studies';
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import PromptLine from '../../components/PromptLine.astro';
import { render } from 'astro:content';
import { PROMPTS, STUDIES, SEO } from '../../lib/constants';
import JsonLd from '../../components/JsonLd.astro';
import styles from './detail.module.css';

export async function getStaticPaths() {
  // draft entries are excluded from all pages
  const entries = await getStudies();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const related = relatedStudies(all, entry);
const date = STUDIES.dateISO(data.date);

/*
 * SEO (ticket 30): entries opt in via colocated `ogImage` frontmatter
 * (spec §8); absent that, a satori-generated terminal card. Article
 * JSON-LD on study details.
 */
const ogImage = data.ogImage ? data.ogImage.src : SEO.og.generatedFor('studies', entry.id);
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.summary,
  datePublished: data.date.toISOString(),
  author: { '@type': 'Person', name: 'Mayur Deshmukh' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  keywords: data.tags.join(', '),
};
---

<TerminalLayout
  title={data.title}
  description={data.summary}
  publishedTime={data.date}
  ogImage={ogImage}
  type="article"
>
  <JsonLd schemas={[article]} />
  <PromptLine
    prompt={PROMPTS.section("studies")}
    href="/studies/"
    command={`show ${entry.id}`}
  />

  <div class={styles.detail}>
    <article class={styles.article}>
      <h1>{data.title}</h1>
      <p class={styles.summary}>{data.summary}</p>
      <Content />
    </article>

    <aside class={styles.side}>
      <p class={styles.cmd} aria-hidden="true">{STUDIES.identify(entry.id)}</p>
      <dl class={styles.sheet}>
        <dt>{STUDIES.datasheet.date}</dt>
        <dd class={styles.dt}>{date}</dd>
        <dt>{STUDIES.datasheet.status}</dt>
        <dd>{data.status}</dd>
        {
          data.projects.length > 0 && (
            <>
              <dt>{STUDIES.datasheet.projects}</dt>
              <dd>
                {data.projects.map((slug, i) => (
                  <>
                    {i > 0 && <span> · </span>}
                    <a href={`/projects/${slug}/`}>{slug}/</a>
                  </>
                ))}
              </dd>
            </>
          )
        }
        {
          data.tags.length > 0 && (
            <>
              <dt>{STUDIES.datasheet.tags}</dt>
              <dd>{data.tags.map((t) => `#${t}`).join(" ")}</dd>
            </>
          )
        }
      </dl>

      <section class={styles.rel}>
        <h2>
          <span class={styles.hash} aria-hidden="true">#</span>
          {STUDIES.relatedHeading}
        </h2>
        {
          related.length === 0 ? (
            <p class={styles.relEmpty}>{STUDIES.relatedEmpty}</p>
          ) : (
            <ul>
              {related.map((e) => (
                <li>
                  <a href={`/studies/${e.id}/`}>
                    <span class={styles.relDate}>
                      {STUDIES.dateISO(e.data.date)}
                    </span>
                    <span class={styles.relTitle}>{e.data.title}</span>
                    <span class={styles.relSummary}>{e.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </aside>
  </div>
</TerminalLayout>
