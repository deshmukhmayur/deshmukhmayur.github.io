---
import { NAV } from "../lib/constants";
import ThemeToggle from "./ThemeToggle.astro";
import styles from "./Nav.module.css";
---

<header class={styles.nav}>
  <nav aria-label="primary">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>
