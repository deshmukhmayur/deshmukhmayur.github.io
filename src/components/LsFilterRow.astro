---
/*
 * Shared `ls <dir> --flag` filter toolbar (spec §2 vocabulary). One active
 * value per flag at a time; rows in the target container carry
 * data-filter-values. Supports several flag groups in one toolbar (they
 * AND together); deep links via ?<flag>=.
 */
export interface FilterOption {
  value: string;
  label: string;
}

export interface FilterGroup {
  /** flag name, e.g. "material" — also used as the URL param */
  flag: string;
  /** first option is the reset ("all"); the rest are real values */
  options: FilterOption[];
}

interface Props {
  /** canonical prompt incl. "$", e.g. "~ $" (ADR 0007); the "$" is
      re-rendered as its own green token */
  prompt?: string;
  /** command shown as the decorative label, e.g. "ls projects" */
  command: string;
  /** single-flag shorthand; merged into groups */
  flag?: string;
  options?: FilterOption[];
  /** multiple flag groups in one toolbar */
  groups?: FilterGroup[];
  /** id of the element holding [data-filter-values] rows */
  targetId: string;
  countSingular: string;
  countPlural: string;
  /** error-message prefix, e.g. "ls: no matches for --" */
  emptyPrefix: string;
  /** server-rendered initial count */
  initialCount: number;
}

import styles from "./LsFilterRow.module.css";

const {
  prompt = "~ $",
  command,
  flag,
  options,
  groups: groupsProp,
  targetId,
  countSingular,
  countPlural,
  emptyPrefix,
  initialCount,
} = Astro.props;

const groups: FilterGroup[] =
  groupsProp ?? (flag && options ? [{ flag, options }] : []);
---

<div
  class={styles.filters}
  data-ls-filter
  data-target={targetId}
  data-count-singular={countSingular}
  data-count-plural={countPlural}
  data-empty-prefix={emptyPrefix}
>
  <span class={styles.lbl} aria-hidden="true">
    <span class={styles.prompt}>{prompt.replace(/\s*\$\s*$/, "")}</span>
    <span class={styles.dollar}>$</span>
    <span class={styles.cmd}>{command}</span>
  </span>
  {
    groups.map((g) => (
      <span class={styles.flaggroup}>
        <span class={styles.flagname} aria-hidden="true">
          --{g.flag}=
        </span>
        <span class={styles.group} role="group" aria-label={`${g.flag} filter`}>
          {g.options.map((o, i) => (
            <button
              type="button"
              class={styles.opt}
              data-value={o.value}
              data-flag={g.flag}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {o.label}
            </button>
          ))}
        </span>
      </span>
    ))
  }
  <span class={styles.count} aria-live="polite">
    <span data-count>{initialCount} {initialCount === 1 ? countSingular : countPlural}</span>
  </span>
  <p class={styles.empty} data-empty hidden>
    <span data-empty-text />{" "}·{" "}
    <button type="button" class={styles.reset} data-reset>reset with {command}</button>
  </p>
</div>

<script>
  /*
   * One root owns all its flag groups; a row is visible only when it matches
   * every active flag. The count and empty state are shared across the root.
   */
  function initFilters(): void {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ls-filter]"),
    );

    for (const root of roots) {
      const targetId = root.dataset.target ?? "";
      const target = document.getElementById(targetId);
      const rows = target
        ? Array.from(target.querySelectorAll<HTMLElement>("[data-filter-values]"))
        : [];
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("button[data-value]"),
      );
      if (!buttons.length || !rows.length) continue;

      const flags = new Map<string, string>();
      const countEl = root.querySelector<HTMLElement>("[data-count]");
      const emptyEl = root.querySelector<HTMLElement>("[data-empty]");
      const emptyText = root.querySelector<HTMLElement>("[data-empty-text]");
      const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset]");
      const singular = root.dataset.countSingular ?? "";
      const plural = root.dataset.countPlural ?? "";
      const emptyPrefix = root.dataset.emptyPrefix ?? "ls: no matches for --";

      const refresh = (pushFlag?: string, pushValue?: string): void => {
        if (pushFlag && pushValue !== undefined) {
          flags.set(pushFlag, pushValue);
          for (const b of buttons) {
            if (b.dataset.flag === pushFlag) {
              b.setAttribute("aria-pressed", String(b.dataset.value === pushValue));
            }
          }
        }
        const active = [...flags.entries()].filter(([, v]) => v !== "all");
        let visible = 0;
        for (const row of rows) {
          const values = (row.dataset.filterValues ?? "").split(" ").filter(Boolean);
          const show = active.every(([, v]) => values.includes(v));
          row.hidden = !show;
          if (show) visible++;
        }
        if (countEl) {
          countEl.textContent = `${visible} ${visible === 1 ? singular : plural}`;
        }
        if (emptyEl && emptyText) {
          emptyEl.hidden = !(visible === 0 && active.length > 0);
          if (!emptyEl.hidden) {
            emptyText.textContent =
              emptyPrefix + active.map(([f, v]) => `${f} ${v}`).join(" --");
          }
        }
        if (pushFlag && pushValue !== undefined) {
          const url = new URL(window.location.href);
          if (pushValue === "all") url.searchParams.delete(pushFlag);
          else url.searchParams.set(pushFlag, pushValue);
          history.replaceState(null, "", url);
        }
      };

      for (const b of buttons) {
        b.addEventListener("click", () =>
          refresh(b.dataset.flag, b.dataset.value ?? "all"),
        );
      }
      resetBtn?.addEventListener("click", () => {
        const url = new URL(window.location.href);
        for (const f of flags.keys()) {
          url.searchParams.delete(f);
        }
        history.replaceState(null, "", url);
        flags.clear();
        refresh();
        for (const b of buttons) {
          b.setAttribute("aria-pressed", String(b.dataset.value === "all"));
        }
      });

      const params = new URLSearchParams(window.location.search);
      for (const f of new Set(buttons.map((b) => b.dataset.flag ?? ""))) {
        const initial = params.get(f);
        const valid =
          initial !== null && buttons.some((b) => b.dataset.flag === f && b.dataset.value === initial);
        refresh(f, valid && initial ? initial : "all");
      }
    }
  }

  initFilters();
</script>
