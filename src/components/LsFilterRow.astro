---
/*
 * Shared `ls <dir> --flag` filter row (spec §2 vocabulary). One active value
 * at a time; rows in the target container carry data-filter-values.
 * Filtering is client-side (static output); supports deep links via ?<flag>=.
 */
export interface FilterOption {
  value: string;
  label: string;
}

interface Props {
  /** full command shown as the decorative label, e.g. "ls projects --kind" */
  command: string;
  /** flag name, e.g. "kind" — also used as the URL param */
  flag: string;
  /** first option is the reset ("all"); the rest are real values */
  options: FilterOption[];
  /** id of the element holding [data-filter-values] rows */
  targetId: string;
  countSingular: string;
  countPlural: string;
  /** error-message prefix, e.g. "ls: no matches for --" */
  emptyPrefix: string;
  /** server-rendered initial count */
  initialCount: number;
}

import styles from "./LsFilterRow.module.css";

const {
  command,
  flag,
  options,
  targetId,
  countSingular,
  countPlural,
  emptyPrefix,
  initialCount,
} = Astro.props;
---

<div
  class={styles.filters}
  data-ls-filter
  data-target={targetId}
  data-flag={flag}
  data-count-singular={countSingular}
  data-count-plural={countPlural}
  data-empty-prefix={emptyPrefix}
>
  <span class={styles.lbl} aria-hidden="true">{command}</span>
  <div class={styles.group} role="group" aria-label={`${flag} filter`}>
    {
      options.map((o, i) => (
        <button
          type="button"
          class={styles.opt}
          data-value={o.value}
          data-flag={flag}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {o.label}
        </button>
      ))
    }
  </div>
  <span class={styles.count} aria-live="polite">
    <span data-count>{initialCount} {initialCount === 1 ? countSingular : countPlural}</span>
  </span>
  <p class={styles.empty} data-empty hidden>
    <span data-empty-text />
    {" "}
    <button type="button" class={styles.reset} data-reset>{command}</button>
  </p>
</div>

<script>
  /*
   * Roots sharing one target combine: each root owns one flag, and a row is
   * visible only when it matches every active flag. Counts and empty states
   * update on all roots after any change.
   */
  function initFilters(): void {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ls-filter]"),
    );

    interface Root {
      root: HTMLElement;
      flag: string;
      buttons: HTMLButtonElement[];
      countEl: HTMLElement | null;
      emptyEl: HTMLElement | null;
      emptyText: HTMLElement | null;
      resetBtn: HTMLButtonElement | null;
      singular: string;
      plural: string;
      emptyPrefix: string;
    }
    interface Group {
      rows: HTMLElement[];
      flags: Map<string, string>;
      roots: Root[];
    }

    const groups = new Map<string, Group>();
    for (const root of roots) {
      const targetId = root.dataset.target ?? "";
      const target = document.getElementById(targetId);
      const rows = target
        ? Array.from(target.querySelectorAll<HTMLElement>("[data-filter-values]"))
        : [];
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("button[data-value]"),
      );
      if (!buttons.length || !rows.length) continue;
      let group = groups.get(targetId);
      if (!group) {
        group = { rows, flags: new Map(), roots: [] };
        groups.set(targetId, group);
      }
      group.roots.push({
        root,
        flag: root.dataset.flag ?? "",
        buttons,
        countEl: root.querySelector<HTMLElement>("[data-count]"),
        emptyEl: root.querySelector<HTMLElement>("[data-empty]"),
        emptyText: root.querySelector<HTMLElement>("[data-empty-text]"),
        resetBtn: root.querySelector<HTMLButtonElement>("[data-reset]"),
        singular: root.dataset.countSingular ?? "",
        plural: root.dataset.countPlural ?? "",
        emptyPrefix: root.dataset.emptyPrefix ?? "ls: no matches for --",
      });
    }

    for (const group of groups.values()) {
      const refresh = (pushFlag?: string, pushValue?: string): void => {
        if (pushFlag && pushValue !== undefined) {
          group.flags.set(pushFlag, pushValue);
          const r = group.roots.find((x) => x.flag === pushFlag);
          if (r) {
            for (const b of r.buttons) {
              b.setAttribute(
                "aria-pressed",
                String(b.dataset.value === pushValue),
              );
            }
          }
        }
        const active = [...group.flags.entries()].filter(
          ([, v]) => v !== "all",
        );
        let visible = 0;
        for (const row of group.rows) {
          const values = (row.dataset.filterValues ?? "").split(" ").filter(Boolean);
          const show = active.every(([, v]) => values.includes(v));
          row.hidden = !show;
          if (show) visible++;
        }
        for (const r of group.roots) {
          if (r.countEl) {
            r.countEl.textContent = `${visible} ${visible === 1 ? r.singular : r.plural}`;
          }
          const value = group.flags.get(r.flag) ?? "all";
          if (r.emptyEl && r.emptyText) {
            r.emptyEl.hidden = !(visible === 0 && value !== "all");
            if (!r.emptyEl.hidden) {
              r.emptyText.textContent = `${r.emptyPrefix}${r.flag} ${value}`;
            }
          }
          if (pushFlag === r.flag && pushValue !== undefined) {
            const url = new URL(window.location.href);
            if (value === "all") url.searchParams.delete(r.flag);
            else url.searchParams.set(r.flag, value);
            history.replaceState(null, "", url);
          }
        }
      };

      for (const r of group.roots) {
        for (const b of r.buttons) {
          b.addEventListener("click", () => refresh(r.flag, b.dataset.value ?? "all"));
        }
        r.resetBtn?.addEventListener("click", () => refresh(r.flag, "all"));

        const initial = new URLSearchParams(window.location.search).get(r.flag);
        const valid =
          initial !== null && r.buttons.some((b) => b.dataset.value === initial);
        refresh(r.flag, valid && initial ? initial : "all");
      }
    }
  }

  initFilters();
</script>
