---
import { FOOTER, SITE, SOCIALS } from "../lib/constants";
import SocialIcon from "./SocialIcon.astro";
import styles from "./Footer.module.css";
---

<footer class={styles.footer} aria-label="footer">
  <pre class={styles.ascii} aria-hidden="true">{FOOTER.ascii}</pre>
  <div class={styles.row}>
    <p>
      {FOOTER.copyright(new Date().getFullYear())} ·{" "}
      <a href={SITE.rss}>{FOOTER.rssLabel}</a> ·{" "}
      <a href="/contact/">{FOOTER.contactLabel}</a>
    </p>
    <div class={styles.social} aria-label="elsewhere">
      {SOCIALS.map((s) => (
        <SocialIcon brand={s.brand} href={s.href} ariaLabel={s.label} />
      ))}
    </div>
  </div>
</footer>
