---
/*
 * BaseHead (ticket 30, spec §8) — owns the <head>. Title cascade:
 * homepage bare / detail `<title> — deshmukhmayur.com` / listing
 * `<Section> — Mayur Deshmukh`. Description cascade: per-page →
 * per-section constant → sitewide default. Canonical, theme-color,
 * RSS discovery, social tags, Person JSON-LD on every page.
 */
import { SITE, SEO } from "../lib/constants";
import JsonLd from "./JsonLd.astro";

interface Props {
  title?: string;
  section?: string;
  description?: string;
  publishedTime?: Date | string;
  ogImage?: string;
  // detail pages emit og:type article (spec §8)
  type?: "article" | "website";
}

const { title, section, description, publishedTime, ogImage, type = "website" } = Astro.props;

// title cascade
const sectionLabel = section ? section.charAt(0).toUpperCase() + section.slice(1) : undefined;
const pageTitle = sectionLabel
  ? `${sectionLabel} — ${SEO.siteName}`
  : title
    ? `${title} — ${SEO.host}`
    : SITE.title;

// description cascade: per-page → per-section → sitewide
const pageDescription =
  description ??
  (section ? SEO.sections[section.toLowerCase() as keyof typeof SEO.sections] : undefined) ??
  SITE.description;

const canonical = new URL(Astro.url.pathname, Astro.site);

// OG image: explicit opt-in → caller-resolved fallback (section static or
// generated card) → static for the section → home card
const image = ogImage ?? SEO.og.staticFor(section ?? "home");
const imageUrl = new URL(image, Astro.site);

// RSS discovery: all three feeds, sitewide first (spec §8)
const feeds = [
  { title: SEO.feeds.sitewide.title, href: SITE.rss },
  { title: SEO.feeds.studies.title, href: "/studies/rss.xml" },
  { title: SEO.feeds.soliloquy.title, href: "/soliloquy/rss.xml" },
];
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.png" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16181d" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f2ec" />

{feeds.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={new URL(f.href, Astro.site)} />)}

<meta property="og:site_name" content={SEO.siteName} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}

<meta name="twitter:site" content={SEO.twitterSite} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={imageUrl} />

<JsonLd person />
